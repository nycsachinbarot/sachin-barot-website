{
  "rewrites": [
    { "source": "/meditate", "destination": "/spacebetween.html" },
    { "source": "/meditate.html", "destination": "/spacebetween.html" },
    { "source": "/spacebetween", "destination": "/spacebetween.html" }
  ],
  "redirects": [
    { "source": "/writing.html", "destination": "/offerings.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
